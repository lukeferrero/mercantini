<%- include('../partials/header', { title: unit.name, user }) %>
<%- include('../partials/project-banner', { project }) %>

<p><a href="/app">&larr; Progetti</a></p>
<h1><%= unit.name %></h1>

<div class="card">
  <h2>Caratteristiche unità</h2>
  <p><strong>mq:</strong> <%= unit.mq || '-' %></p>
  <%- include('../partials/dynamic-fields', { fields, savedValues, attachmentsByField, canEdit: false }) %>
  <% if (fields.length === 0) { %><p class="muted">Nessuna caratteristica configurata.</p><% } %>
</div>

<div class="card">
  <h2>Stanze</h2>
  <table>
    <thead><tr><th>Nome</th><th>Tipo</th></tr></thead>
    <tbody>
      <% rooms.forEach(r => { %>
      <tr><td><a href="/app/rooms/<%= r.id %>"><%= r.name %></a></td><td><span class="badge"><%= r.room_type %></span></td></tr>
      <% }) %>
      <% if (rooms.length === 0) { %><tr><td colspan="2">Nessuna stanza.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
