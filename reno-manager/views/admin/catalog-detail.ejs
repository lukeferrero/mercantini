<%- include('../partials/header', { title: catalogItem.label, user: typeof user !== 'undefined' ? user : null }) %>

<p><a href="/admin/catalog">&larr; Catalogo</a></p>
<h1><%= catalogItem.label %></h1>
<p class="badge"><%= options.length %> / <%= maxOptions %> opzioni</p>

<% if (options.length < maxOptions) { %>
<div class="card">
  <h2>Nuova opzione</h2>
  <form method="POST" action="/admin/catalog/<%= catalogItem.type %>/options" enctype="multipart/form-data">
    <div class="form-row inline">
      <input type="text" name="label" placeholder="Nome opzione" required style="flex:2">
      <input type="text" name="fornitore" placeholder="Fornitore" style="flex:1">
      <input type="file" name="photo" accept="image/*" style="flex:1">
      <button class="btn" type="submit">Aggiungi</button>
    </div>
  </form>
</div>
<% } %>

<div class="card">
  <div class="options-grid">
    <% options.forEach(o => { %>
      <div class="option-card">
        <% if (o.photo_path) { %><img class="option-thumb" src="<%= o.photo_path %>" alt="<%= o.label %>"><% } %>
        <div style="font-size:13px;margin-top:4px;"><%= o.label %><% if (o.fornitore) { %> <span class="option-fornitore">(<%= o.fornitore %>)</span><% } %></div>
        <form method="POST" action="/admin/catalog/options/<%= o.id %>" enctype="multipart/form-data" style="margin-top:6px;">
          <input type="text" name="label" value="<%= o.label %>" placeholder="Nome opzione" style="margin-bottom:6px;font-size:13px;padding:5px 8px;">
          <input type="text" name="fornitore" value="<%= o.fornitore || '' %>" placeholder="Fornitore" style="margin-bottom:6px;font-size:13px;padding:5px 8px;">
          <input type="file" name="photo" accept="image/*" style="margin-bottom:6px;font-size:12px;">
          <button class="btn secondary" type="submit" style="padding:3px 8px;font-size:11px;width:100%;">Salva modifiche</button>
        </form>
        <form method="POST" action="/admin/catalog/options/<%= o.id %>/delete" onsubmit="return confirm('Eliminare questa opzione?')">
          <button class="btn danger" style="padding:3px 8px;font-size:11px;margin-top:6px;width:100%;">Elimina</button>
        </form>
      </div>
    <% }) %>
    <% if (options.length === 0) { %><p>Nessuna opzione ancora.</p><% } %>
  </div>
</div>

<%- include('../partials/footer') %>
