<%- include('../partials/header', { title: unit.name, user: typeof user !== 'undefined' ? user : null }) %>

<p><a href="/admin/projects/<%= unit.project_id %>">&larr; Torna al progetto</a></p>
<h1><%= unit.name %></h1>

<div class="card">
  <h2>Caratteristiche unità</h2>
  <form method="POST" action="/admin/units/<%= unit.id %>">
    <div class="form-row inline">
      <div style="flex:2"><label>Nome</label><input type="text" name="name" value="<%= unit.name %>" required></div>
      <div style="flex:1"><label>mq</label><input type="number" step="0.01" name="mq" value="<%= unit.mq || '' %>"></div>
    </div>
    <div class="form-row inline">
      <div style="flex:1">
        <label>Portoncino blindato</label>
        <select name="portoncino_tipo">
          <option value="">-- seleziona --</option>
          <% portoncinoOptions.forEach(o => { %>
            <option value="<%= o.id %>" <%= String(unit.portoncino_tipo) === String(o.id) ? 'selected' : '' %>><%= o.label %></option>
          <% }) %>
        </select>
        <% if (portoncinoOptions.length === 0) { %>
          <small><a href="/admin/catalog/portoncino_blindato">Aggiungi opzioni in Catalogo &rarr;</a></small>
        <% } %>
      </div>
      <div style="flex:1"><label>Spioncino</label>
        <select name="portoncino_spioncino">
          <option value="" <%= !unit.portoncino_spioncino ? 'selected' : '' %>>-</option>
          <option value="si" <%= unit.portoncino_spioncino === 'si' ? 'selected' : '' %>>Sì</option>
          <option value="no" <%= unit.portoncino_spioncino === 'no' ? 'selected' : '' %>>No</option>
        </select>
      </div>
      <div style="flex:1"><label>Colore portoncino</label><input type="text" name="portoncino_colore" value="<%= unit.portoncino_colore || '' %>"></div>
    </div>
    <div class="form-row">
      <label>Maniglie</label>
      <select name="maniglie_tipo">
        <option value="">-- seleziona --</option>
        <% manigliaOptions.forEach(o => { %>
          <option value="<%= o.id %>" <%= String(unit.maniglie_tipo) === String(o.id) ? 'selected' : '' %>><%= o.label %></option>
        <% }) %>
      </select>
      <% if (manigliaOptions.length === 0) { %>
        <small><a href="/admin/catalog/maniglie">Aggiungi opzioni in Catalogo &rarr;</a></small>
      <% } %>
    </div>
    <div class="form-row">
      <label>Quadro elettrico - note</label>
      <textarea name="quadro_elettrico_note"><%= unit.quadro_elettrico_note || '' %></textarea>
    </div>
    <button class="btn" type="submit">Salva</button>
  </form>
</div>

<div class="card">
  <h2>Nuova stanza</h2>
  <form method="POST" action="/admin/units/<%= unit.id %>/rooms">
    <div class="form-row inline">
      <input type="text" name="name" placeholder="Nome stanza (es. Bagno principale)" required style="flex:2">
      <select name="room_type" required style="flex:1">
        <option value="">Tipo stanza</option>
        <option value="bagno">Bagno</option>
        <option value="soggiorno">Soggiorno</option>
        <option value="ingresso">Ingresso</option>
        <option value="letto">Camera da letto</option>
        <option value="cucina">Cucina</option>
        <option value="altro">Altro</option>
      </select>
      <button class="btn" type="submit">Aggiungi</button>
    </div>
  </form>
</div>

<div class="card">
  <h2>Stanze</h2>
  <table>
    <thead><tr><th>Nome</th><th>Tipo</th><th></th></tr></thead>
    <tbody>
      <% rooms.forEach(r => { %>
      <tr>
        <td><a href="/app/rooms/<%= r.id %>"><%= r.name %></a></td>
        <td><span class="badge"><%= r.room_type %></span></td>
        <td>
          <form method="POST" action="/admin/rooms/<%= r.id %>/delete" onsubmit="return confirm('Eliminare questa stanza?')" style="display:inline">
            <button class="btn danger" style="padding:4px 10px;font-size:12px;">Elimina</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (rooms.length === 0) { %><tr><td colspan="3">Nessuna stanza ancora.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
