<%- include('../partials/header', { title: project.name, user: typeof user !== 'undefined' ? user : null }) %>
<%- include('../partials/project-banner', { project }) %>

<p><a href="/admin">&larr; Progetti</a></p>
<h1><%= project.name %></h1>
<p class="badge"><%= units.length %> / <%= project.units_count %> unità inserite</p>

<div class="card">
  <h2>Immagine del progetto</h2>
  <p class="muted" style="margin-top:-6px;margin-bottom:12px;">Mostrata in cima a questa pagina e a tutte le pagine di unità e stanze di questo progetto.</p>
  <% if (project.image_path) { %>
    <img src="<%= project.image_path %>" alt="<%= project.name %>" style="max-width:200px;border-radius:8px;display:block;margin-bottom:12px;">
  <% } %>
  <form method="POST" action="/admin/projects/<%= project.id %>/image" enctype="multipart/form-data">
    <div class="form-row inline">
      <input type="file" name="image" accept="image/*" style="flex:2">
      <button class="btn" type="submit">Carica</button>
      <% if (project.image_path) { %>
      <button class="btn danger" type="submit" formaction="/admin/projects/<%= project.id %>/image/delete" formnovalidate>Rimuovi</button>
      <% } %>
    </div>
  </form>
</div>

<div class="card">
  <h2>Nuova unità immobiliare</h2>
  <form method="POST" action="/admin/projects/<%= project.id %>/units">
    <div class="form-row inline">
      <input type="text" name="name" placeholder="Nome unità (es. Appartamento 3)" required style="flex:2">
      <input type="number" step="0.01" name="mq" placeholder="mq" style="flex:1">
      <button class="btn" type="submit">Aggiungi</button>
    </div>
  </form>
</div>

<div class="card">
  <h2>Unità</h2>
  <table>
    <thead><tr><th>Nome</th><th>mq</th><th></th></tr></thead>
    <tbody>
      <% units.forEach(u => { %>
      <tr>
        <td><a href="/admin/units/<%= u.id %>"><%= u.name %></a></td>
        <td><%= u.mq || '-' %></td>
        <td>
          <form method="POST" action="/admin/units/<%= u.id %>/delete" onsubmit="return confirm('Eliminare questa unità?')" style="display:inline">
            <button class="btn danger" style="padding:4px 10px;font-size:12px;">Elimina</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (units.length === 0) { %><tr><td colspan="3">Nessuna unità ancora.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
