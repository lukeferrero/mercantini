<%- include('../partials/header', { title: 'Tipi di stanza', user: typeof user !== 'undefined' ? user : null }) %>

<p><a href="/admin">&larr; Backend</a></p>
<h1>Tipi di stanza</h1>

<div class="card">
  <h2>Nuovo tipo di stanza</h2>
  <form method="POST" action="/admin/room-types">
    <div class="form-row inline">
      <input type="text" name="label" placeholder="Nome tipo (es. Cantina, Terrazzo...)" required style="flex:2">
      <button class="btn" type="submit">Crea</button>
    </div>
  </form>
</div>

<div class="card">
  <table>
    <thead><tr><th>Tipo</th><th>Chiave</th><th></th></tr></thead>
    <tbody>
      <% roomTypes.forEach(rt => { %>
      <tr>
        <td><%= rt.label %></td>
        <td><span class="badge"><%= rt.slug %></span></td>
        <td>
          <a href="/admin/room-types/<%= rt.slug %>/fields" class="btn secondary" style="padding:4px 10px;font-size:12px;">Campi</a>
          <form method="POST" action="/admin/room-types/<%= rt.slug %>/delete" onsubmit="return confirm('Eliminare questo tipo di stanza? Deve non essere usato da nessuna stanza esistente.')" style="display:inline">
            <button class="btn danger" style="padding:4px 10px;font-size:12px;">Elimina</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (roomTypes.length === 0) { %><tr><td colspan="3">Nessun tipo di stanza ancora.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
