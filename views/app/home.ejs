<%- include('../partials/header', { title: 'Progetti', user }) %>

<h1>Progetti</h1>

<% projects.forEach(p => { %>
<div class="card">
  <h2><%= p.name %></h2>
  <%
    const filledDocs = docSlots.filter(s => docsByProject[p.id][s.key]);
    const hasNote = p.note && p.note.trim() !== '';
  %>
  <% if (filledDocs.length > 0 || hasNote) { %>
  <details class="project-docs">
    <summary>Documenti e note del progetto</summary>
    <% filledDocs.forEach(s => { const d = docsByProject[p.id][s.key]; %>
      <div class="project-doc-row">
        <strong class="project-doc-label"><%= s.label %></strong>
        <a href="<%= d.file_path %>" download="<%= d.original_name %>" class="badge">📎 <%= d.original_name %></a>
      </div>
    <% }) %>
    <% if (hasNote) { %>
      <div class="project-doc-row" style="display:block;">
        <strong class="project-doc-label">Note</strong>
        <div class="note-display" style="margin-top:6px;"><%= p.note %></div>
      </div>
    <% } %>
  </details>
  <% } %>
  <table>
    <thead><tr><th>Unità</th><th>mq</th></tr></thead>
    <tbody>
      <% unitsByProject[p.id].forEach(u => { %>
      <tr><td><a href="/app/units/<%= u.id %>"><%= u.name %></a></td><td><%= u.mq || '-' %></td></tr>
      <% }) %>
      <% if (unitsByProject[p.id].length === 0) { %><tr><td colspan="2">Nessuna unità.</td></tr><% } %>
    </tbody>
  </table>
</div>
<% }) %>
<% if (projects.length === 0) { %><p>Nessun progetto disponibile.</p><% } %>

<%- include('../partials/footer') %>
